<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and up: the starting window, which StarlingActivity keeps until the game's
         first frame, shows the game's dark background matching setup (#121214). -->
    <style name="Starling.Game" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowSplashScreenBackground">#FF121214</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:statusBarColor">#FF121214</item>
        <item name="android:navigationBarColor">#FF121214</item>
        <item name="android:windowBackground">#FF121214</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
